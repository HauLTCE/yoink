# Ship only what's needed to run: the package, packaging config, license, readme.
# Everything else (tests/, docs/, proposal/, caches, scratch) stays local.

# Ignore everything
*

# Re-include the essentials
!.gitignore
!LICENSE
!README.md
!pyproject.toml
!yoink/
!yoink/**

# But never generated Python files inside the package
__pycache__/
*.py[cod]
*.egg-info/
